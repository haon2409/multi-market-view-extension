{
  "manifest_version": 3,
  "name": "Multi-Market Indices Tracker",
  "version": "1.2",
  "description": "Theo dõi danh sách các chỉ số/cổ phiếu từ DNSE và Yahoo Finance",
  
  "icons": {
    "64": "icon64.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon64.png"
  },

  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.dnse.com.vn/*",
    "https://query1.finance.yahoo.com/*"
  ]
}